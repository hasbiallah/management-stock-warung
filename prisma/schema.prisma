generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model OwnerAccount {
  id           String   @id @default(cuid())
  singleton    Boolean  @unique @default(true)
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
